<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="meerkatdesktop"
        Arguments=""
        InstallLocation="C:\Program Files\Meerkat\Meerkat">
    </Installer>
    <PackageInformation
        PackageName="Meerkat"
        PackageDisplayName="Meerkat"
        PublisherName="CN=Meerkat"
        PublisherDisplayName="Meerkat"
        Version="0.1.0.0"
        PackageDescription="Meerkat desktop control plane">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.meerkat.desktop"
                Description="Meerkat desktop control plane"
                DisplayName="Meerkat"
                ExecutableName="meerkatdesktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Meerkat</DisplayName>
            <PublisherDisplayName>Meerkat</PublisherDisplayName>
            <Description>Meerkat desktop control plane</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="meerkatdesktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
